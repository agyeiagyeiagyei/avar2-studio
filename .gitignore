# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
dist/
/build/
*.egg
.venv/
venv/

# Node
frontend/node_modules/
frontend/build/
frontend/.eslintcache

# Frontend bundle assembled by release CI — never commit
src/avar2_studio/static/

# Tool scratch
.avar2-studio/

# Launching directly against a bundled fixture bootstraps a sibling
# CSV — keep the shipped fixtures git-clean (the Load Font dropdown
# stages examples into ~/.avar2-studio/workspace/ for the same reason)
examples/*/sources/*-avar.csv

# EXCEPT the crispy-mini exemplar: its mappings CSV, transforms, and
# axis metadata ship deliberately so the bundled example opens as a
# complete three-axis avar2 demo (opsz/wght/wdth + width-aware SPAC).
!examples/crispy-mini/sources/CrispyMini-avar.csv
!examples/crispy-mini/sources/.avar2-studio/
examples/crispy-mini/sources/.avar2-studio/*
!examples/crispy-mini/sources/.avar2-studio/axis-metadata.json

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
/tmp/preview-server.log

# GitHub Pages build artifacts (generated in CI)
frontend/public/static-demo/
frontend/dist-pages/

# Rust/wasm build artifacts
wasm/fontc-web/pkg/
wasm/fontc-web/target/
