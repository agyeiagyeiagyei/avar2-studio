#!/usr/bin/env python3
"""Patched ``gftools-gen-avar2`` — fvar axis-duplication fix.

Upstream bug (gftools/scripts/gen_avar2.py, gen_fvar_axes):

    if axis_name not in font["fvar"].axes:

compares a tag STRING against Axis OBJECTS, so the membership check is
always True and every avar2 ``in:`` axis is appended to the fvar even
when an axis with that tag already exists. Traditional mappings
(in: wght/wdth on a parametric font) never noticed — those axes really
were new. The studio's parametric-only mappings (in: = the font's own
XOPQ/XTRA/YOPQ) hit it head-on: every parametric axis lands in the
fvar TWICE, and any non-default location applies both copies' deltas —
glyphs render roughly double-wide along XTRA, which reads as a
mysterious tracking/spacing transform.

This shim pre-filters each mapping's ``in:`` dict down to axes the
font does NOT already have before handing off to the upstream
function, which then behaves identically for the traditional case and
appends nothing for parametric-in mappings. The studio prepends this
script's directory to PATH for the gftools-builder subprocess
(server.py, _perform_avar2_build), so it shadows the venv console
script of the same name. Delete it once the check is fixed upstream.
"""
import json
import os
import sys

from gftools.scripts import gen_avar2 as _mod

_orig_gen_fvar_axes = _mod.gen_fvar_axes

# Studio-declared ranges for CREATED axes, {tag: [min, default, max]},
# passed via env by _perform_avar2_build. Upstream derives a created
# axis's range purely from the mapping in: values and sets default=min
# — which makes the lowest-mapped instance THE ORIGIN of the variation
# space, and avar2 cannot remap the origin (the default location must
# map to itself), so that instance's mapping silently disappears. The
# studio's declared metadata (e.g. opsz 18…144 default 72) puts the
# default where the designer said it is; every in: location then
# normalizes against it consistently before the model is built.
try:
    _DECLARED = json.loads(os.environ.get("AVAR2_STUDIO_AXIS_RANGES", "") or "{}")
except Exception:
    _DECLARED = {}


def _fixed_gen_fvar_axes(font, mapping):
    existing = {str(a.axisTag) for a in font["fvar"].axes}
    filtered = [
        {**m, "in": {k: v for k, v in m["in"].items() if k not in existing}}
        for m in mapping
    ]
    result = _orig_gen_fvar_axes(font, filtered)
    for a in font["fvar"].axes:
        tag = str(a.axisTag)
        if tag in existing or tag not in _DECLARED:
            continue  # only axes this run created, only if declared
        try:
            lo, d, hi = (float(v) for v in _DECLARED[tag])
        except (TypeError, ValueError):
            continue
        if lo <= d <= hi:
            a.minValue, a.defaultValue, a.maxValue = lo, d, hi
    return result


_mod.gen_fvar_axes = _fixed_gen_fvar_axes


def _rebase_parametric_defaults() -> None:
    """Export-with-default support. ``AVAR2_STUDIO_EXPORT_DEFAULTS``
    ({tag: newDefault}) moves the PLAIN font's axis defaults via
    fontTools instancer L3 — full ranges kept, gvar deltas rebased —
    before the avar2 table is generated, so the table's normalization
    is built against the new origin. This must happen HERE: fontTools
    refuses partial-instancing once an avar2 table exists, and this
    shim is the last moment the font is still plain."""
    raw = os.environ.get("AVAR2_STUDIO_EXPORT_DEFAULTS", "")
    if not raw:
        return
    try:
        new_defaults = {str(k): float(v) for k, v in json.loads(raw).items()}
    except (ValueError, TypeError):
        print("shim: bad AVAR2_STUDIO_EXPORT_DEFAULTS, ignoring", file=sys.stderr)
        return
    font_path = next((a for a in sys.argv[1:] if a.lower().endswith(".ttf")), None)
    if font_path is None:
        return
    from fontTools.ttLib import TTFont
    from fontTools.varLib import instancer

    tt = TTFont(font_path)
    limits = {}
    for a in tt["fvar"].axes:
        tag = str(a.axisTag)
        if tag in new_defaults:
            lo, hi = float(a.minValue), float(a.maxValue)
            d = max(lo, min(hi, new_defaults[tag]))
            limits[tag] = (lo, d, hi)
    if not limits:
        return
    out = instancer.instantiateVariableFont(tt, limits, inplace=False, updateFontNames=False)
    out.save(font_path)
    print(f"shim: rebased axis defaults for export: "
          + ", ".join(f"{t}={v[1]}" for t, v in limits.items()), file=sys.stderr)


if __name__ == "__main__":
    _rebase_parametric_defaults()
    sys.exit(_mod.main())
